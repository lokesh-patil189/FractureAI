# Copy this file to .env (or export these variables in your shell).
BONEAI_ENV=development
# Set a long random secret before exposing the app beyond a local demo.
BONEAI_SECRET_KEY=replace-with-a-long-random-value

# Optional trained model configuration. The app runs its upload/history workflow
# without these weights, but never invents a medical prediction.
BONEAI_MODEL_PATH=
BONEAI_BACKEND=keras
BONEAI_INPUT_SIZE=224
BONEAI_CHANNELS=1
BONEAI_FRACTURE_INDEX=1
BONEAI_THRESHOLD=0.5
# Set to 1 only when serving over HTTPS.
BONEAI_HTTPS=0
